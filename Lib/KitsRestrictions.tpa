//__________________________________________________________________________________
//__________________________________________________________________________________
//
//								  KITS RESTRICTIONS
//__________________________________________________________________________________
//__________________________________________________________________________________

COPY_EXISTING_REGEXP ~.*\.itm~ override
	READ_BYTE 0x31 proficiency
	SET match = 0

	// Heartwarder of Sune
	PATCH_IF MOD_IS_INSTALLED ~DeitiesOfFaerun.tp2~ ~3~ BEGIN

		PATCH_MATCH proficiency WITH
			89 90 91 92 93 94 95 96 98 99 103 104 105 BEGIN
				LPF ADD_ITEM_EQEFFECT
					INT_VAR
						opcode     = 319
						target     = 1
						parameter1 = IDS_OF_SYMBOL (~Kit~ ~RASune~)
						parameter2 = 9
						timing     = 2
				END
				LPF ADD_ITEM_EQEFFECT
					INT_VAR
						opcode     = 319
						target     = 1
						parameter1 = IDS_OF_SYMBOL (~Kit~ ~RASuneCT~)
						parameter2 = 9
						timing     = 2
				END
				LPF ADD_ITEM_EQEFFECT
					INT_VAR
						opcode     = 319
						target     = 1
						parameter1 = IDS_OF_SYMBOL (~Kit~ ~RASuneFC~)
						parameter2 = 9
						timing     = 2
				END
				SET match = 1
			END
			DEFAULT
		END
	END

