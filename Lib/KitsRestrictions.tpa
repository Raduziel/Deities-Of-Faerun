	// Nightcloak of Shar
	PATCH_IF MOD_IS_INSTALLED ~DeitiesOfFaerun.tp2~ ~6~ BEGIN

		PATCH_MATCH proficiency WITH
			89 90 91 92 93 94 95 96 98 99 103 104 105 106 BEGIN
				LPF ADD_ITEM_EQEFFECT
					INT_VAR
						opcode     = 319
						target     = 1
						parameter1 = IDS_OF_SYMBOL (~Kit~ ~RAShar~)
						parameter2 = 9
						timing     = 2
				END
				LPF ADD_ITEM_EQEFFECT
					INT_VAR
						opcode     = 319
						target     = 1
						parameter1 = IDS_OF_SYMBOL (~Kit~ ~RASharCM~)
						parameter2 = 9
						timing     = 2
				END
				LPF ADD_ITEM_EQEFFECT
					INT_VAR
						opcode     = 319
						target     = 1
						parameter1 = IDS_OF_SYMBOL (~Kit~ ~RASharCT~)
						parameter2 = 9
						timing     = 2
				END
				SET match = 1
			END
			DEFAULT
		END	
	

		PATCH_IF (SOURCE_SIZE > 0x71) AND (match = 0) BEGIN
			READ_BYTE 0x18 flags1
			PATCH_IF ((flags1 & BIT3) = BIT3) BEGIN
				READ_ASCII 0x22 animation (2)
				TO_UPPER animation
				PATCH_MATCH ~%animation%~ WITH
					~4A~ BEGIN
						LPF ~ADD_ITEM_EQEFFECT~ INT_VAR opcode = 319 target = 1 timing = 2 parameter1 = IDS_OF_SYMBOL (~Kit~ ~RAShar~)   parameter2 = 9 END
						LPF ~ADD_ITEM_EQEFFECT~ INT_VAR opcode = 319 target = 1 timing = 2 parameter1 = IDS_OF_SYMBOL (~Kit~ ~RASharCM~) parameter2 = 9 END
						LPF ~ADD_ITEM_EQEFFECT~ INT_VAR opcode = 319 target = 1 timing = 2 parameter1 = IDS_OF_SYMBOL (~Kit~ ~RASharCT~) parameter2 = 9 END
					END
					DEFAULT
					END
			END
		END

	END

	// Hoodwinker of Baravar
	PATCH_IF MOD_IS_INSTALLED ~DeitiesOfFaerun.tp2~ ~8~ BEGIN

		PATCH_MATCH proficiency WITH
			89 90 92 93 94 95 97 98 99 100 101 104 BEGIN
				LPF ADD_ITEM_EQEFFECT
					INT_VAR
						opcode     = 319
						target     = 1
						parameter1 = IDS_OF_SYMBOL (~Kit~ ~RABara~)
						parameter2 = 9
						timing     = 2
				END
				LPF ADD_ITEM_EQEFFECT
					INT_VAR
						opcode     = 319
						target     = 1
						parameter1 = IDS_OF_SYMBOL (~Kit~ ~RABaraCM~)
						parameter2 = 9
						timing     = 2
				END
				LPF ADD_ITEM_EQEFFECT
					INT_VAR
						opcode     = 319
						target     = 1
						parameter1 = IDS_OF_SYMBOL (~Kit~ ~RABaraCT~)
						parameter2 = 9
						timing     = 2
				END
				SET match = 1
			END
			DEFAULT
			END

		PATCH_IF (SOURCE_SIZE > 0x71) AND (match = 0) BEGIN
			READ_BYTE 0x18 flags1
			PATCH_IF ((flags1 & BIT3) = BIT3) BEGIN
				READ_ASCII 0x22 animation (2)
				TO_UPPER animation
				PATCH_MATCH ~%animation%~ WITH
					~4A~ ~3A~ BEGIN
					PATCH_MATCH ~%SOURCE_RES%~ WITH
                    ~CHAN12~ ~CHAN13~ ~CHAN14~ ~CHAN16~ ~CHAN19~ ~DWCHAN01~ ~DWCHAN02~ ~ELFCHAN~ BEGIN
                    END
                    DEFAULT
						LPF ~ADD_ITEM_EQEFFECT~ INT_VAR opcode = 319 target = 1 timing = 2 parameter1 = IDS_OF_SYMBOL (~Kit~ ~RABara~)   parameter2 = 9 END
						LPF ~ADD_ITEM_EQEFFECT~ INT_VAR opcode = 319 target = 1 timing = 2 parameter1 = IDS_OF_SYMBOL (~Kit~ ~RABaraCM~) parameter2 = 9 END
						LPF ~ADD_ITEM_EQEFFECT~ INT_VAR opcode = 319 target = 1 timing = 2 parameter1 = IDS_OF_SYMBOL (~Kit~ ~RABaraCT~) parameter2 = 9 END
					END
				END	
				DEFAULT
				END
			END
		END

	END

